
<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIYAM SM CHAT</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      background: #eaf3ff;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
    }

    .app {
      width: 100%;
      max-width: 400px;
      min-height: 560px;
      background: white;
      border-radius: 24px;
      padding: 28px 22px;
      box-shadow: 0 10px 35px #174b871c;
      text-align: center;
    }

    .logo {
      width: 85px;
      height: 85px;
      border-radius: 24px;
      background: linear-gradient(135deg, #1769e0, #063d91);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 25px;
      font-weight: bold;
      margin: 12px auto 20px;
    }

    h1 {
      color: #123d78;
      font-size: 25px;
      margin-bottom: 10px;
    }

    .subtitle {
      color: #77869b;
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 28px;
    }

    .field {
      width: 100%;
      padding: 16px;
      border: 1px solid #d8e3f1;
      border-radius: 12px;
      font-size: 16px;
      outline: none;
      margin-bottom: 15px;
    }

    .field:focus {
      border-color: #1769e0;
    }

    .btn {
      width: 100%;
      padding: 16px;
      border: none;
      border-radius: 12px;
      background: #1769e0;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .btn:active {
      background: #0b4eae;
    }

    .hidden {
      display: none;
    }

    .footer {
      margin-top: 35px;
      color: #9aa8ba;
      font-size: 12px;
    }

    .back {
      color: #1769e0;
      background: none;
      border: none;
      margin-top: 20px;
      font-size: 14px;
      cursor: pointer;
    }

    .chat-header {
      background: #1769e0;
      color: white;
      padding: 18px;
      border-radius: 14px;
      margin-bottom: 25px;
      font-weight: bold;
    }

    .chat-message {
      background: #eaf3ff;
      padding: 15px;
      border-radius: 12px;
      text-align: left;
      color: #24466f;
      margin-bottom: 12px;
    }
  </style>
</head>

<body>

  <main class="app">

    <section id="loginScreen">
      <div class="logo">SM</div>

      <h1>SIYAM SM CHAT</h1>
      <p class="subtitle">
        Welcome to SIYAM SM CHAT<br>
        আপনার ফোন নম্বর দিয়ে লগইন করুন
      </p>

      <input
        class="field"
        id="phone"
        type="tel"
        placeholder="+880 1XXXXXXXXX"
        autocomplete="tel"
      >

      <button class="btn" onclick="sendOTP()">
        Send OTP
      </button>

      <p class="footer">
        Secure Login • SIYAM SM CHAT
      </p>
    </section>

    <section id="otpScreen" class="hidden">
      <div class="logo">SM</div>

      <h1>Verify Your Number</h1>
      <p class="subtitle">
        আপনার ফোনে পাঠানো OTP কোডটি লিখুন
      </p>

      <input
        class="field"
        id="otp"
        type="text"
        inputmode="numeric"
        maxlength="6"
        placeholder="Enter 6 digit OTP"
      >

      <button class="btn" onclick="verifyOTP()">
        Verify OTP
      </button>

      <button class="back" onclick="goBack()">
        ← Back to Login
      </button>
    </section>

    <section id="chatScreen" class="hidden">
      <div class="chat-header">
        SIYAM SM CHAT
      </div>

      <h1>Welcome!</h1>
      <p class="subtitle">
        আপনার Chat Dashboard
      </p>

      <div class="chat-message">
        SIYAM SM CHAT-এ আপনাকে স্বাগতম!
      </div>

      <div class="chat-message">
        আপনার বন্ধুদের সঙ্গে চ্যাট করার সুবিধা এখানে তৈরি করা হবে।
      </div>

      <button class="btn" onclick="logout()">
        Logout
      </button>
    </section>

  </main>

  <script>
    function sendOTP() {
      const phone = document.getElementById("phone").value.trim();

      if (!phone) {
        alert("আপনার ফোন নম্বর লিখুন");
        return;
      }

      document.getElementById("loginScreen").classList.add("hidden");
      document.getElementById("otpScreen").classList.remove("hidden");
    }

    function verifyOTP() {
      const otp = document.getElementById("otp").value.trim();

      if (!otp) {
        alert("OTP কোড লিখুন");
        return;
      }

      alert("এটি শুধু ডিজাইন পরীক্ষা। আসল OTP যাচাই Firebase যুক্ত করার পর হবে।");
    }

    function goBack() {
      document.getElementById("otpScreen").classList.add("hidden");
      document.getElementById("loginScreen").classList.remove("hidden");
    }

    function logout() {
      document.getElementById("chatScreen").classList.add("hidden");
      document.getElementById("loginScreen").classList.remove("hidden");
    }
  </script>

</body>
</html>
