
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SIYAM SM CHAT</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #eaf3ff;
  font-family: Arial, sans-serif;
}

.login {
  width: 90%;
  max-width: 380px;
  padding: 28px;
  background: white;
  border-radius: 22px;
  box-shadow: 0 8px 30px #0002;
  text-align: center;
}

.logo {
  background: #1769e0;
  color: white;
  padding: 25px;
  border-radius: 16px;
  font-size: 27px;
  font-weight: bold;
}

h2 {
  color: #17243a;
  margin-top: 28px;
}

p {
  color: #718096;
}

input {
  width: 100%;
  padding: 15px;
  margin: 12px 0;
  border: 1px solid #ddd;
  border-radius: 10px;
  font-size: 16px;
}

button {
  width: 100%;
  padding: 15px;
  background: #1769e0;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
}

button:active {
  opacity: 0.8;
}

#otpScreen {
  display: none;
}
</style>
</head>

<body>

<div class="login">

  <div class="logo">
    SIYAM SM
    <div style="font-size:13px;margin-top:8px">
      CHAT APP
    </div>
  </div>

  <div id="loginScreen">
    <h2>Welcome Back!</h2>
    <p>Login with your phone number</p>

    <input
      type="tel"
      id="phone"
      placeholder="+8801XXXXXXXXX"
    >

    <button onclick="sendOTP()">
      Send OTP
    </button>
  </div>

  <div id="otpScreen">
    <h2>Verify OTP</h2>
    <p>Enter your verification code</p>

    <input
      type="text"
      id="otp"
      placeholder="Enter 6 digit OTP"
      maxlength="6"
    >

    <button onclick="verifyOTP()">
      Verify OTP
    </button>
  </div>

  <p style="font-size:12px;margin-top:22px">
    Secure Login • SIYAM SM
  </p>

</div>

<script>
function sendOTP() {
  const phone = document.getElementById("phone").value;

  if (!/^\+8801[3-9]\d{8}$/.test(phone)) {
    alert("Enter a valid Bangladesh phone number");
    return;
  }

  document.getElementById("loginScreen").style.display = "none";
  document.getElementById("otpScreen").style.display = "block";

  alert("Login screen ready. Firebase OTP will be connected next.");
}

function verifyOTP() {
  alert("Firebase OTP verification will be connected next.");
}
</script>

</body>
</html>
